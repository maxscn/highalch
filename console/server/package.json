{
  "name": "@highalch/console-server",
  "version": "0.0.0",
  "private": true,
  "description": "HighAlch Console Cloudflare Worker: hosts the Console model and serves ConsoleApi (WebSocket and HTTP), Better Auth, the Stripe webhook and signed artifact links.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "ALCHEMY_PROFILE=highalch-local-only CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000 alchemy dev --no-input --stage local"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "catalog:",
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/domain": "catalog:",
    "@alchemy.run/stripe": "catalog:",
    "@distilled.cloud/stripe": "catalog:",
    "@highalch/console-domain": "workspace:*",
    "alchemy": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node": "catalog:",
    "@highalch/console-client": "workspace:*",
    "@highalch/story": "workspace:*",
    "@lowalch/tanstack-db": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
