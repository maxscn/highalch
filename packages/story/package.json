{
  "name": "@highalch/story",
  "version": "0.0.5",
  "description": "Stories for LowAlch data and the XState machines over it: given, when, then, with screenshots painted without a browser.",
  "keywords": [
    "alchemy",
    "effect",
    "tanstack-db",
    "testing",
    "xstate"
  ],
  "homepage": "https://github.com/maxscn/highalch/tree/main/packages/story#readme",
  "bugs": {
    "url": "https://github.com/maxscn/highalch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxscn/highalch.git",
    "directory": "packages/story"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./xstate": {
      "types": "./dist/xstate.d.mts",
      "default": "./dist/xstate.mjs"
    },
    "./screen": {
      "types": "./dist/screen.d.mts",
      "default": "./dist/screen.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@alchemy.run/domain": "catalog:",
    "@effect/atom-react": "catalog:",
    "@lowalch/tanstack-db": "workspace:*",
    "@tanstack/db": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@xstate/effect": "catalog:",
    "effect": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "takumi-js": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "xstate": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/domain": "2.0.0-beta.87",
    "@effect/atom-react": "^4.1.4",
    "@lowalch/tanstack-db": "workspace:^",
    "@tanstack/db": "1.0.0-rc.1.5",
    "@xstate/effect": "1.0.0-beta.2",
    "effect": "^4.1.4",
    "happy-dom": "^20.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "takumi-js": "^2.14.0",
    "xstate": "6.0.0-beta.3"
  },
  "peerDependenciesMeta": {
    "@effect/atom-react": {
      "optional": true
    },
    "@xstate/effect": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "takumi-js": {
      "optional": true
    },
    "xstate": {
      "optional": true
    }
  }
}
