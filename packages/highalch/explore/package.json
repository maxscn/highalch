{
  "name": "@highalch/explore",
  "version": "0.0.0",
  "description": "Explorations of HighAlch stories: every sequence of what can happen, deterministically, shrunk and replayed; sharded and streamed.",
  "keywords": [
    "alchemy",
    "effect",
    "exploration",
    "testing",
    "xstate"
  ],
  "homepage": "https://github.com/maxscn/highalch/tree/main/packages/highalch/explore#readme",
  "bugs": {
    "url": "https://github.com/maxscn/highalch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxscn/highalch.git",
    "directory": "packages/highalch/explore"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./xstate": {
      "types": "./dist/xstate.d.mts",
      "default": "./dist/xstate.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@highalch/stream": "workspace:^"
  },
  "devDependencies": {
    "@highalch/alchemy-domain": "workspace:*",
    "@highalch/screen": "workspace:*",
    "@highalch/story": "workspace:*",
    "@highalch/stream": "workspace:*",
    "@highalch/studio": "workspace:*",
    "@highalch/takumi": "workspace:*",
    "@highalch/tanstack-db": "workspace:*",
    "@highalch/tanstack-form": "workspace:*",
    "@highalch/xstate": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "ws": "catalog:",
    "xstate": "catalog:"
  },
  "peerDependencies": {
    "@highalch/story": "workspace:^",
    "effect": "^4.1.4",
    "xstate": "6.0.0-beta.3"
  },
  "peerDependenciesMeta": {
    "xstate": {
      "optional": true
    }
  }
}
