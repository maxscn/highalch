{
  "name": "@highalch/tanstack-db",
  "version": "0.0.7",
  "description": "Data steps for HighAlch stories on TanStack DB: what a client's sources show, how its commands settle, readers and rules.",
  "keywords": [
    "alchemy",
    "effect",
    "highalch",
    "testing"
  ],
  "homepage": "https://github.com/maxscn/highalch/tree/main/packages/highalch/tanstack-db#readme",
  "bugs": {
    "url": "https://github.com/maxscn/highalch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxscn/highalch.git",
    "directory": "packages/highalch/tanstack-db"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "default": "./dist/internal.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@highalch/story": "workspace:*",
    "@tanstack/db": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@highalch/story": "workspace:^",
    "@tanstack/db": "1.0.0-rc.1.5",
    "@tanstack/react-db": "1.0.0-rc.1.5",
    "effect": "^4.1.4",
    "react": "^19.2.7"
  }
}
