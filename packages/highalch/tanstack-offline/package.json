    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@highalch/story": "workspace:^",
    "@highalch/tanstack-db": "workspace:^",
    "@tanstack/offline-transactions": "1.2.0",
    "effect": "^4.1.4"
