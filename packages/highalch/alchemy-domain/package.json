{
  "name": "@highalch/alchemy-domain",
  "version": "0.0.0",
  "description": "HighAlch stories of apps on an alchemy Domain: the Domain hosted in memory with LowAlch clients, its steps and the feed rules.",
  "keywords": [
    "alchemy",
    "effect",
    "highalch",
    "testing"
  ],
  "homepage": "https://github.com/maxscn/highalch/tree/main/packages/highalch/alchemy-domain#readme",
