    "@tanstack/db": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/domain": "2.0.0-beta.87",
    "@highalch/story": "workspace:^",
    "@highalch/tanstack-db": "workspace:^",
    "@highalch/tanstack-offline": "workspace:^",
    "@lowalch/tanstack-db": "workspace:^",
    "@tanstack/db": "1.0.0-rc.1.5",
    "effect": "^4.1.4",
    "react": "^19.2.7"
  }
