{
  "name": "@highalch/studio",
  "version": "0.0.0",
  "description": "A local browser viewer and relay for HighAlch explorations, available through the `highalch studio` command.",
  "keywords": [
    "alchemy",
    "effect",
    "studio",
    "testing"
  ],
  "homepage": "https://github.com/maxscn/highalch/tree/main/packages/highalch/studio#readme",
  "bugs": {
    "url": "https://github.com/maxscn/highalch/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxscn/highalch.git",
    "directory": "packages/highalch/studio"
  },
  "bin": {
    "highalch": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@highalch/stream": "workspace:^",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@highalch/stream": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  }
}
