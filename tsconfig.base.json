{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@lowalch/tanstack-db": ["./packages/lowalch/tanstack-db/src/index.ts"],
      "@lowalch/tanstack-db/server": ["./packages/lowalch/tanstack-db/src/server.ts"],
      "@lowalch/tanstack-db/react": ["./packages/lowalch/tanstack-db/src/react.tsx"],
      "@lowalch/tanstack-db/xstate": ["./packages/lowalch/tanstack-db/src/xstate/index.ts"],
      "@lowalch/tanstack-db/offline": ["./packages/lowalch/tanstack-db/src/offline/index.ts"],
      "@lowalch/tanstack-db/internal": ["./packages/lowalch/tanstack-db/src/internal.ts"],
      "@highalch/examples": ["./packages/highalch/examples/src/index.ts"],
      "@highalch/story": ["./packages/highalch/story/src/index.ts"],
      "@highalch/story/internal": ["./packages/highalch/story/src/internal.ts"],
      "@highalch/tanstack-db": ["./packages/highalch/tanstack-db/src/index.ts"],
      "@highalch/tanstack-db/internal": ["./packages/highalch/tanstack-db/src/internal.ts"],
      "@highalch/xstate": ["./packages/highalch/xstate/src/index.ts"],
      "@highalch/screen": ["./packages/highalch/screen/src/index.ts"],
      "@highalch/screen/internal": ["./packages/highalch/screen/src/internal.ts"],
      "@highalch/takumi": ["./packages/highalch/takumi/src/index.ts"],
      "@highalch/tanstack-form": ["./packages/highalch/tanstack-form/src/index.ts"],
      "@highalch/tanstack-form/vite": ["./packages/highalch/tanstack-form/src/vite.ts"],
      "@highalch/tanstack-form/react-form": ["./packages/highalch/tanstack-form/src/react-form.ts"],
      "@highalch/alchemy-domain": ["./packages/highalch/alchemy-domain/src/index.ts"],
      "@highalch/explore": ["./packages/highalch/explore/src/index.ts"],
      "@highalch/explore/xstate": ["./packages/highalch/explore/src/xstate/index.ts"],
      "@highalch/stream": ["./packages/highalch/stream/src/index.ts"],
      "@highalch/studio": ["./packages/highalch/studio/src/index.ts"]
    }
  }
}
