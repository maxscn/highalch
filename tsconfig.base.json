{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@lowalch/tanstack-db": ["./packages/tanstack-db/src/index.ts"],
      "@lowalch/tanstack-db/server": ["./packages/tanstack-db/src/server.ts"],
      "@lowalch/tanstack-db/react": ["./packages/tanstack-db/src/react.tsx"],
      "@lowalch/tanstack-db/xstate": ["./packages/tanstack-db/src/xstate/index.ts"],
      "@lowalch/tanstack-db/internal": ["./packages/tanstack-db/src/internal.ts"],
      "@highalch/story": ["./packages/story/src/index.ts"],
      "@highalch/story/tanstack-db": ["./packages/story/src/tanstack-db/index.ts"],
      "@highalch/story/xstate": ["./packages/story/src/xstate/index.ts"],
      "@highalch/story/screen": ["./packages/story/src/screen/index.ts"]
    }
  }
}
