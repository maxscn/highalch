{
  "name": "highalch",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "typecheck": "tsc -p packages/tanstack-db && tsc -p packages/story && tsc -p packages/stream && tsc -p packages/studio && tsc -p packages/explore && tsc -p packages/examples && tsc -p .",
    "check:patterns": "node scripts/check-patterns.ts",
    "test": "vp test --maxWorkers=2",
    "ready": "vp check && vp run check:patterns && vp run typecheck && vp run test && vp run build",
    "changeset": "changeset",
    "release:version": "changeset version && vp fmt"
  },
  "devDependencies": {
    "@alchemy.run/domain": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/atom-react": "catalog:",
    "@tanstack/db": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@xstate/effect": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "xstate": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
